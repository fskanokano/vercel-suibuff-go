# =====================================================================
# vercel-suibuff-go — Vercel 部署环境变量（云上最小配置）
# 全部通过 Vercel Dashboard → Settings → Environment Variables 设置，
# 或 `vercel env add`。无需任何本地文件。
# =====================================================================

# --- 监听端口 -------------------------------------------------------
# Vercel 为每个实例注入动态 PORT（如 44465），健康检查只会连它。
# 根入口优先监听 PORT；LISTEN_ADDR 仅在无 PORT 时生效（本地/自建）。
# 无需设置 LISTEN_ADDR（设了也会被 PORT 覆盖）。
# LISTEN_ADDR=:3000

# --- Token 配置（二选一）--------------------------------------------
# A) Pooled 模式：一个或多个 FreeBuff token，逗号分隔。
#    代理自动做 hot-session-first 池化 + failover。
AUTH_TOKENS=cb_your_token_here

# B) Bridge 模式：将 AUTH_TOKENS 留空，客户端每次请求
#    带 `Authorization: Bearer <cb_token>`，代理原样转发（无存储）。
# AUTH_TOKENS=

# --- 云上必关 -------------------------------------------------------
# 上游代理默认会读本机 CLI 登录文件 (~/.config/manicode/credentials.json)
# 自动发现 token —— Vercel 容器里没有，设为 false 跳过。
AUTO_DISCOVER_TOKEN=false

# --- 客户端鉴权（可选）-----------------------------------------------
# 代理自身的 API key（`Authorization: Bearer <key>` 或 `x-api-key`）。
# 留空 = 无鉴权（配合 Bridge 模式时，客户端 key 就是上游 token）。
API_KEYS=

# --- 安全/隐身（默认已开，无需改动）----------------------------------
# SAFE_MODE=true 时自动应用：TLS 指纹、header 清洗、请求抖动、空闲轮换。
SAFE_MODE=true
# TLS 指纹：chrome | firefox | safari | edge | random（默认 chrome）
TLS_FINGERPRINT=chrome

# --- 上游（默认无需改）-----------------------------------------------
# UPSTREAM_BASE_URL=https://codebuff.com
# COST_MODE=free

# --- 日志 -----------------------------------------------------------
LOG_LEVEL=info

# --- 云上无意义的项 ---------------------------------------------------
# LOG_FILE           （容器无持久盘）
# ADMIN_TOKEN        （/admin/reload 读本地 .env，云端无配置文件可重载）
# HTTP_PROXY / SOCKS5_PROXY / SOCKS5_PROXIES
#                     （Vercel 出站网络可用代理，但默认不需要；uTLS 已在容器内生效）
# ROTATION_INTERVAL / REQUEST_TIMEOUT / MAX_MESSAGES_PER_DAY 等
#                     （高级调优项，按需从上游 README 复制）
